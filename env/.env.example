# Point de montage du partage NAS (utilisé par les scripts + docker-compose).
# IMPORTANT : utiliser /mnt/wsl/horus, PAS /mnt/horus. Docker Desktop ne voit le
# FS d'Ubuntu que via /mnt/wsl (propagation "shared"). Un bind sur /mnt/horus
# capture le répertoire ext4 vide sous le point de montage -> le conteneur voit
# des dossiers VIDES. /mnt/wsl/horus est le vrai montage CIFS partagé, visible
# par Docker, et il marche aussi pour les exécutions locales.
NAS_MOUNT=/mnt/wsl/horus

# ── Réglages convert-h265 (surcharge le bloc de config du script) ─────────────
# Dossiers à scanner récursivement, séparés par des virgules (sans espace autour
# des virgules, ou alors ils seront strippés). Chaque dossier est traité l'un
# après l'autre, avec un total global affiché à la fin.
INPUT_FOLDERS=/mnt/wsl/horus/tvshows,/mnt/wsl/horus/movies,/mnt/wsl/horus/cartoons
# Qualité : plus bas = meilleur (24–28 conseillé)
CQ=26
# Préréglage NVENC : p1 (rapide) -> p7 (meilleure qualité)
PRESET=p4
# true = simulation seule (aucune conversion, aucun fichier écrit/supprimé)
DRY_RUN=false
